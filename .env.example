# SENTINEL AI — Environment Configuration Example
# Copy to .env and fill in optional values. Never commit real secrets.

# Optional Google Gemini API key for AI Remediation Copilot
# If omitted, SENTINEL AI falls back to deterministic rule-based remediation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Local Authorised Test Applications (Loopback Only)
SENTINEL_HIGH_SEC_HOST=127.0.0.1
SENTINEL_HIGH_SEC_PORT=5051
SENTINEL_DEMO_HOST=127.0.0.1
SENTINEL_DEMO_PORT=5050

# Lab-specific token required by the Low-Security App's local remediation API
SENTINEL_REMEDIATION_TOKEN=sentinel-local-lab-approval-token

# Optional SQLite override
# SENTINEL_DATABASE_URL=sqlite:///data/sentinel_ai.db
